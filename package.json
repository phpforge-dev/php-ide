{
  "name": "php-ide",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "node scripts/tauri.mjs build --bundles app",
    "start": "node scripts/start-native.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "node scripts/cargo.mjs test",
    "setup:php": "node scripts/setup-php.mjs",
    "setup:acp": "node scripts/setup-acp.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "tsc --noEmit && vite build",
    "test:native": "npm run build:web && node scripts/cargo.mjs build && node scripts/check-native.mjs --production-ui",
    "test:rust": "node scripts/cargo.mjs test",
    "test:ui": "node scripts/check-native.mjs",
    "tauri": "node scripts/tauri.mjs",
    "test:packaged": "node scripts/check-native.mjs --packaged",
    "test:locales": "node scripts/check-locales.mjs",
    "test:php-semantics": "node --import tsx --test tests/php-hierarchy.test.ts && tsx scripts/check-php-semantics.ts",
    "test:web-languages": "node scripts/check-web-languages.mjs",
    "test:web-native": "node scripts/check-native.mjs --packaged --no-db --web-only",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm run test:architecture && npm run test:unit && npm test && npm run lint:rust && npm run test:locales",
    "lint:rust": "node scripts/cargo.mjs clippy --all-targets -- -D warnings",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:formatting": "node --import tsx --test tests/formatting.test.ts",
    "test:formatting:ui": "node scripts/check-formatting.mjs",
    "setup:plugins": "node scripts/prepare-plugin-tests.mjs",
    "pretypecheck": "npm run setup:plugins",
    "pretest:unit": "npm run setup:plugins",
    "pretest:formatting": "npm run setup:plugins",
    "pretest:native": "npm run setup:plugins",
    "pretest:ui": "npm run setup:plugins",
    "test:plugins:ui": "node scripts/check-default-plugins.mjs",
    "test:images": "node scripts/check-image-preview.mjs",
    "test:plugins:native": "npm run test:native -- --no-db --plugins-only",
    "test:maintenance:ui": "node scripts/check-app-maintenance.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.14.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "dt-sql-parser": "4.5.1",
    "ignore": "7.0.14",
    "php-parser": "3.7.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "license": "MIT"
}
