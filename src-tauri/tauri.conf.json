{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHP IDE",
  "version": "0.2.0",
  "identifier": "dev.php-ide.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PHP IDE",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../fixtures/": "fixtures/",
      "../.tools/phpactor.phar": ".tools/phpactor.phar",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../src/assets/jetbrains-icons/LICENSE.txt": "licenses/jetbrains-icons/LICENSE.txt",
      "../src/assets/jetbrains-icons/NOTICE.txt": "licenses/jetbrains-icons/NOTICE.txt",
      "../src/assets/jetbrains-icons/manifest.json": "licenses/jetbrains-icons/manifest.json",
      "../.tools/phpactor.phar.patch.json": ".tools/phpactor.phar.patch.json",
      "../licenses/web-language-services/": "licenses/web-language-services/"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
